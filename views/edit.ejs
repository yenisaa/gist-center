<%- include('partials/headers.ejs') %>

<section class="create-post" id="edit">
  <div class="back-home">
    <a href="/post/<%= blogSpecificPost.id %>" class="go-home">Back to post <span>&rarr;</span></a>
    <h2>Edit Post</h2>
  </div>

  <form action="/edit/<%= blogSpecificPost.id %>" method="post" class="create-form">
    <div>
      <label for="title">Title</label>
      <input type="text" name="title" id="title" value="<%= blogSpecificPost.title %>">
    </div>

    <div>
      <label for="author">Author</label>
      <input type="text" name="author" id="author" value="<%= blogSpecificPost.author %>">
    </div>

    <div>
      <label for="excerpt">Excerpt</label>
      <input type="text" name="excerpt" id="excerpt" value="<%= blogSpecificPost.excerpt %>">
    </div>

    <div>
      <label for="content">Content</label>
      <textarea name="content" id="content"><%= blogSpecificPost.content %></textarea>
    </div>

    <div class="form-buttons">
      <a href="/post/<%= blogSpecificPost.id %>" class="btn">Cancel</a>
      <input type="submit" value="Update Post" class="btn-publish btn">
    </div>
  </form>
</section>

<%- include('partials/footer.ejs') %>