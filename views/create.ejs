
<%- include('partials/headers.ejs') %>

<section class="create-post">
  <div class="back-home">
    <a href="/" class="go-home">Back to home <span>&rarr;</span></a>
    <h2>Create New Post</h2>

</div>

  <form action="/create/new" method="post" class="create-form">
    <div class="">
        <label for="title">Title </label>
        <input type="text" name="title" id="title" placeholder="Enter your title">
    </div>
    <div class="">
        <label for="author">Author </label>
        <input type="text" name="author" id="author" placeholder="Enter author name">
    </div>
    
    <div class="">
        <label for="excerpt">Excerpt </label>
        <input type="text" name="excerpt" id="excerpt" placeholder="Enter your excerpt"  cols="30" rows="20" >
    </div>

    <div class="">
        <label for="content">Content </label>
        <textarea type="text" name="content" id="content" placeholder="Enter your content" aria-colspan="5" cols="50" rows="10" >
        </textarea>
    </div>

    <div class="form-buttons">
        <a href="/"><button class="btn">Cancel</button></a>
        <input type="submit" value="Publish" class="btn-publish btn">
    </div>
  </form>
</section>

<%- include('partials/footer.ejs') %>